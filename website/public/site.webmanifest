{
  "name": "Universal DateTime Picker",
  "short_name": "DateTime Picker",
  "description": "Date and time picker for React, vanilla JS, Web Components, Vue, Svelte, and Angular. TypeScript, accessible calendar, ranges, and themes.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f3f6ef",
  "theme_color": "#3f6a28",
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}

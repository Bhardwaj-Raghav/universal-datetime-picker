---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import {
  FRAMEWORKS,
  FRAMEWORK_CARD_SUMMARY,
  HOME_SNIPPETS,
  HOME_SNIPPET_TABS,
} from "../frameworks";
import { GITHUB_URL, NPM_URL, PACKAGE_VERSION, SITE_FAQS } from "../site.config";

const features = [
  {
    title: "Works everywhere",
    body: "Native React date picker plus Web Components and vanilla createDateTimePicker — Vue, Svelte, Angular, plain HTML, and CDN from one npm package.",
  },
  {
    title: "Pick and go",
    body: "Date-only overlays commit and close on day click. Datetime and time overlays keep an OK button so you can adjust the clock first. DateTimeInput includes a calendar icon, customInput, and noStyle.",
  },
  {
    title: "Accessible calendar & time UI",
    body: "Dialog semantics, focus trap, Escape to dismiss, and arrow-key navigation. Opens on the first or last selectable day when min/max bounds apply.",
  },
  {
    title: "Typed Date / TimeValue by default",
    body: "Omit asString for native Date and TimeValue objects. CSS-variable themes, 12-hour clocks, locales, and TypeScript exports across ESM/CJS.",
  },
];

const customTriggerSnippet = `import { createDateTimePicker } from "universal-datetime-picker/vanilla";
import "universal-datetime-picker/style.css";

const button = document.getElementById("trigger");
const host = document.getElementById("picker-host");

button?.addEventListener("click", () => {
  createDateTimePicker(host, {
    mode: "date",
    popover: true,
    anchorEl: button,
    open: true,
    asString: false,
    onChange: console.log,
  });
});`;

const modalTriggerSnippet = `createDateTimePicker(document.getElementById("modal-root"), {
  mode: "date",
  open: true,
  asString: false,
  onChange: console.log,
});`;

const cdnSnippet = HOME_SNIPPETS.cdn;
const vanillaSnippet = HOME_SNIPPETS["vanilla-tab"];

const installCmd = "npm install universal-datetime-picker";
---

<BaseLayout includeFaq={true} includeSoftwareApplication={true}>
  <div class="site is-ready">
    <div class="site-bg" aria-hidden="true"></div>

    <SiteNav />

    <main id="top">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow">v{PACKAGE_VERSION} · React date picker · Vanilla · Vue · Svelte · Angular · CDN</p>
          <p class="brand-kicker">universal-datetime-picker</p>
          <h1 id="hero-heading" class="hero-brand">
            Universal React date picker &amp; date time picker for every framework
          </h1>
          <p class="hero-lead">
            This page runs on the vanilla <code>createDateTimePicker</code> API — no
            React on the home route. Date-only picks commit immediately; datetime uses OK
            after you set the time. <code>DateTimeInput</code> adds a calendar icon and
            returns native <code>Date</code> objects by default. Choose a framework below
            for a live demo and copy-paste setup.
          </p>
          <div class="hero-actions">
            <a class="btn btn-ghost" href="#live-demo">Try the live demo</a>
          </div>
          <div class="install-line">
            <code class="install-line__cmd" data-install-cmd>{installCmd}</code>
            <button
              type="button"
              class="install-copy"
              data-copy-install
              aria-label="Copy install command"
              title="Copy"
            >
              <svg
                data-copy-icon="default"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg
                data-copy-icon="done"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <div class="hero-stage" id="live-demo">
          <div class="stage-glow" aria-hidden="true"></div>
          <div class="stage-panel">
            <h2 class="stage-label">Live vanilla date-time input</h2>
            <input id="hero-input" type="text" aria-label="Pick a date and time" placeholder="Click to open — confirm with OK" />
            <p class="stage-value">
              Selected: <span id="hero-value">null</span>
            </p>
          </div>
        </div>
      </section>

      <section class="features" id="features" aria-labelledby="features-heading">
        <h2 id="features-heading" class="section-heading">
          Why teams pick this calendar and datetime component
        </h2>
        <div class="features-grid">
          {
            features.map((feature, index) => (
              <article
                class="feature"
                style={`animation-delay: ${0.12 + index * 0.08}s`}
              >
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="showcase"
        id="examples"
        aria-labelledby="examples-heading"
      >
        <div class="showcase-head">
          <h2 id="examples-heading">
            Date picker, time picker, and date range examples
          </h2>
          <p>
            All blocks below mount with <code>createDateTimePicker</code> and <code>createDateTimeRangePicker</code>, including past/future disables and min/max windows. Framework-specific pages show
            the same UI through React, Vue, Web Components, or CDN.
          </p>
        </div>
        <div class="showcase-grid home-vanilla-grid">
          <div class="showcase-block">
            <h3>Date · disable past</h3>
            <p class="showcase-note"><code>disablePastDates</code> — past days greyed out.</p>
            <div id="ex-date"></div>
            <pre class="stage-value" id="ex-date-out">null</pre>
          </div>
          <div class="showcase-block">
            <h3>Date · disable future</h3>
            <p class="showcase-note"><code>disableFutureDates</code> — future days blocked.</p>
            <div id="ex-date-nofuture"></div>
            <pre class="stage-value" id="ex-date-nofuture-out">null</pre>
          </div>
          <div class="showcase-block">
            <h3>Date · min &amp; max</h3>
            <p class="showcase-note"><code>minDate</code> / <code>maxDate</code> — window from 7 days ago to 14 days ahead.</p>
            <div id="ex-date-bounds"></div>
            <pre class="stage-value" id="ex-date-bounds-out">null</pre>
          </div>
          <div class="showcase-block">
            <h3>Time only · TimeValue</h3>
            <p class="showcase-note">Popover — adjust time, then press <strong>OK</strong> to commit.</p>
            <input id="ex-time-anchor" type="text" aria-label="Pick a time" placeholder="Open time picker" />
            <pre class="stage-value" id="ex-time-out">null</pre>
          </div>
          <div class="showcase-block">
            <h3>Time · no seconds</h3>
            <p class="showcase-note">Popover without seconds — confirm with <strong>OK</strong>.</p>
            <input id="ex-time-ns-anchor" type="text" aria-label="Pick a time without seconds" placeholder="Open time picker" />
            <pre class="stage-value" id="ex-time-ns-out">null</pre>
          </div>
          <div class="showcase-block">
            <h3>Combined date &amp; time · Date</h3>
            <p class="showcase-note">Datetime popover — day + time draft until <strong>OK</strong>.</p>
            <input id="ex-combined-anchor" type="text" aria-label="Pick date and time" placeholder="Open datetime picker" />
            <pre class="stage-value" id="ex-combined-out">null</pre>
          </div>
          <div class="showcase-block">
            <h3>Separate view (tabs) · Date</h3>
            <p class="showcase-note">Tabs layout popover — confirm with <strong>OK</strong>.</p>
            <input id="ex-tabs-anchor" type="text" aria-label="Pick date and time with tabs" placeholder="Open tabs datetime" />
            <pre class="stage-value" id="ex-tabs-out">null</pre>
          </div>
          <div class="showcase-block">
            <h3>Input · string (asString)</h3>
            <p class="showcase-note">Datetime input — commit with <strong>OK</strong> (not on day click alone).</p>
            <input id="ex-input-anchor" type="text" aria-label="Pick a date and time" placeholder="Opens empty — confirm with OK" />
            <pre class="stage-value" id="ex-input-out">null</pre>
          </div>
          <div class="showcase-block">
            <h3>Input · booking window</h3>
            <p class="showcase-note">Popover with past disabled and a 30-day <code>maxDate</code>.</p>
            <input id="ex-input-bounds-anchor" type="text" aria-label="Book a date" placeholder="Today → +30 days" />
            <pre class="stage-value" id="ex-input-bounds-out">null</pre>
          </div>
          <div class="showcase-block">
            <h3>Date range · past disabled</h3>
            <p class="showcase-note">Range picker with <code>disablePastDates</code>.</p>
            <div id="ex-range"></div>
            <pre class="stage-value" id="ex-range-out">null → null</pre>
          </div>
          <div class="showcase-block">
            <h3>French locale · week starts Monday</h3>
            <div id="ex-locale"></div>
            <pre class="stage-value" id="ex-locale-out">null</pre>
          </div>
          <div class="showcase-block showcase-block--dark" data-ctp-theme="dark">
            <h3>Dark theme · date &amp; time popover</h3>
            <div id="ex-dark-date"></div>
            <input
              id="ex-dark-input"
              type="text"
              aria-label="Pick a time"
            />
            <pre class="stage-value" id="ex-dark-out">Date: null</pre>
          </div>
        </div>
      </section>

      <section class="snippet" id="how-to-use" aria-labelledby="how-to-use-heading">
        <h2 id="how-to-use-heading">Use any button as the trigger (vanilla)</h2>
        <p class="snippet-lead">
          Control <code>open</code> and pass <code>anchorEl</code> with
          <code>popover</code> to place the calendar beside your control.
        </p>
        <pre><code>{customTriggerSnippet}</code></pre>

        <h3>Open it as a modal</h3>
        <p class="snippet-lead">
          Omit <code>popover</code> and <code>anchorEl</code> for a centered modal.
        </p>
        <pre><code>{modalTriggerSnippet}</code></pre>

        <h3>CDN custom element</h3>
        <p class="snippet-lead">
          See the <a href="/cdn/">CDN demo page</a> for a live jsDelivr example.
        </p>
        <pre><code>{cdnSnippet}</code></pre>

        <h3>Vanilla mount</h3>
        <p class="snippet-lead">
          Same API powering every example on this page.
        </p>
        <pre><code>{vanillaSnippet}</code></pre>
      </section>

      <section class="snippet" id="frameworks" aria-labelledby="frameworks-heading">
        <h2 id="frameworks-heading">Pick your framework</h2>
        <p class="snippet-lead">
          Each link opens a page with a live demo and framework-specific install
          code.
        </p>
        <div class="framework-cards">
          {
            FRAMEWORKS.map((fw) => (
              <a class="framework-card" href={`/${fw.slug}/`}>
                <strong>{fw.label}</strong>
                <span class="framework-card__desc">
                  {FRAMEWORK_CARD_SUMMARY[fw.slug]}
                </span>
                <span class="framework-card__cta">Live demo →</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="snippet" id="install" aria-labelledby="install-heading">
        <h2 id="install-heading">
          Install for React, Vue, Svelte, Angular, vanilla, or CDN
        </h2>
        <p class="snippet-lead">
          One npm package with subpath exports. Each tab links to a full demo
          page.
        </p>
        <div
          class="install-tabs"
          data-home-tabs
        >
          <div class="install-tablist" role="tablist" aria-label="Framework">
            {
              HOME_SNIPPET_TABS.map((t) => (
                <button
                  type="button"
                  role="tab"
                  data-tab={t.id}
                  class:list={{ "is-active": t.id === "react" }}
                  aria-selected={t.id === "react" ? "true" : "false"}
                >
                  {t.label}
                </button>
              ))
            }
          </div>
          <div class="install-panel">
            <button type="button" class="install-panel-copy" data-home-copy>
              Copy
            </button>
            <pre><code data-home-snippet-code>{HOME_SNIPPETS.react}</code></pre>
            <a class="install-demo-link" data-home-demo-link href="/react/">
              See the live React demo →
            </a>
          </div>
        </div>
      </section>

      <section class="faq" id="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Date time picker FAQ</h2>
        <div class="faq-list">
          {
            SITE_FAQS.map((faq) => (
              <details class="faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>
        MIT-licensed date time picker for React, Vue, Svelte, Angular, vanilla
        &amp; CDN ·{" "}
        <a href={NPM_URL} target="_blank" rel="noreferrer">
          universal-datetime-picker on npm
        </a>{" "}
        ·{" "}
        <a href={GITHUB_URL} target="_blank" rel="noreferrer">
          Source on GitHub
        </a>
      </p>
    </footer>
  </div>

  <script>
    import {
      initHomeCopyInstall,
      initHomeInstallTabs,
      initHomeVanillaDemos,
    } from "../scripts/homeVanilla.ts";

    const destroyDemos = initHomeVanillaDemos();
    initHomeInstallTabs();
    initHomeCopyInstall();

    document.addEventListener("astro:before-preparation", () => {
      destroyDemos();
    });
  </script>
</BaseLayout>

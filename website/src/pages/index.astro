---
import BaseLayout from "../layouts/BaseLayout.astro";
import CopyInstall from "../components/CopyInstall";
import HeroDemo from "../components/HeroDemo";
import ExamplesDemo from "../components/ExamplesDemo";
import { GITHUB_URL, NPM_URL, SITE_FAQS } from "../site.config";

const features = [
  {
    title: "Typed React date picker",
    body: "First-class TypeScript exports for DateTime, DateTimeInput, and DateTimeRange — ESM/CJS builds ready for React 17+ apps.",
  },
  {
    title: "Accessible calendar & time UI",
    body: "Dialog semantics, focus trap, Escape to dismiss, and arrow-key navigation so your React datetime picker works with keyboards and assistive tech.",
  },
  {
    title: "Themeable date time picker",
    body: "One stylesheet, CSS variables for light/dark themes, 12-hour clocks, locales, and custom labels without forking.",
  },
];

const installSnippet = `import { useState } from "react";
import DateTime, { DateTimeInput } from "react-calendar-time";
import "react-calendar-time/style.css";

function App() {
  const [value, setValue] = useState(null);
  // asString={false} → Date (date/datetime) or TimeValue (time)
  return <DateTimeInput asString={false} value={value} onChange={setValue} />;
}`;

const customTriggerSnippet = `function CustomDateTrigger() {
  const [open, setOpen] = useState(false);
  const [value, setValue] = useState<Date | null>(null);
  const [anchorEl, setAnchorEl] = useState<HTMLButtonElement | null>(null);

  return (
    <>
      <button
        ref={setAnchorEl}
        type="button"
        onClick={() => setOpen(true)}
        aria-haspopup="dialog"
        aria-expanded={open}
      >
        {value ? value.toLocaleDateString() : "Choose a date"}
      </button>

      <DateTime
        mode="date"
        open={open}
        onOpenChange={setOpen}
        popover
        anchorEl={anchorEl}
        asString={false}
        value={value}
        onChange={(next) =>
          setValue(next instanceof Date ? next : null)
        }
      />
    </>
  );
}`;

const modalTriggerSnippet = `<button type="button" onClick={() => setOpen(true)}>
  Choose a date
</button>
<DateTime
  mode="date"
  open={open}
  onOpenChange={setOpen}
  asString={false}
  onChange={setValue}
/>`;
---

<BaseLayout>
  <div class="site is-ready">
    <div class="site-bg" aria-hidden="true"></div>

    <header class="topbar">
      <a class="brand" href="#top">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">react-calendar-time</span>
      </a>
      <nav class="topnav" aria-label="Primary">
        <a href="#live-demo">Live demo</a>
        <a href="#features">Features</a>
        <a href="#examples">Examples</a>
        <a href="#how-to-use">How to use</a>
        <a href="#install">Install</a>
        <a href="#faq">FAQ</a>
        <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow">v1.1 · npm React date time picker</p>
          <p class="brand-kicker">react-calendar-time</p>
          <h1 id="hero-heading" class="hero-brand">
            React date time picker for calendar, time &amp; ranges
          </h1>
          <p class="hero-lead">
            An accessible React date picker, time picker, and datetime calendar
            in one TypeScript package — themable UI, dayjs-powered values, ready
            for production forms.
          </p>
          <CopyInstall client:load />
        </div>

        <HeroDemo client:load />
      </section>

      <section class="features" id="features" aria-labelledby="features-heading">
        <h2 id="features-heading" class="section-heading">
          Why teams pick this React calendar and datetime component
        </h2>
        <div class="features-grid">
          {
            features.map((feature, index) => (
              <article
                class="feature"
                style={`animation-delay: ${0.12 + index * 0.08}s`}
              >
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="showcase" id="examples" aria-labelledby="examples-heading">
        <div class="showcase-head">
          <h2 id="examples-heading">
            React date picker, time picker, and date range examples
          </h2>
          <p>
            Date-only, time-only, combined datetime, date range picker, locales,
            and dark theme — one React calendar API for every mode.
          </p>
        </div>
        <ExamplesDemo client:visible />
      </section>

      <section class="snippet" id="how-to-use" aria-labelledby="how-to-use-heading">
        <h2 id="how-to-use-heading">Use any button or input as the trigger</h2>
        <p class="snippet-lead">
          Control <code>open</code> from your own element. Pass that element to
          <code>anchorEl</code> with <code>popover</code> to place the calendar
          beside it.
        </p>
        <pre><code>{customTriggerSnippet}</code></pre>

        <h3>Open it as a modal</h3>
        <p class="snippet-lead">
          Leave out <code>popover</code> and <code>anchorEl</code> for a centered
          modal.
        </p>
        <pre><code>{modalTriggerSnippet}</code></pre>
      </section>

      <section class="snippet" id="install" aria-labelledby="install-heading">
        <h2 id="install-heading">
          Install the React date time picker from npm
        </h2>
        <p class="snippet-lead">
          Add <code>react-calendar-time</code> to any React app, import the
          datetime picker, and ship a calendar with time selection in minutes.
        </p>
        <pre><code>{installSnippet}</code></pre>
      </section>

      <section class="faq" id="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">React date time picker FAQ</h2>
        <div class="faq-list">
          {
            SITE_FAQS.map((faq) => (
              <details class="faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>
        MIT-licensed React date time picker and calendar component ·{" "}
        <a href={NPM_URL} target="_blank" rel="noreferrer">
          react-calendar-time on npm
        </a>{" "}
        ·{" "}
        <a href={GITHUB_URL} target="_blank" rel="noreferrer">
          Source on GitHub
        </a>
      </p>
    </footer>
  </div>
</BaseLayout>

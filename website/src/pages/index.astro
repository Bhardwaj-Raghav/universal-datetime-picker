---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import {
  HOME_SNIPPETS,
  HOME_SNIPPET_TABS,
} from "../frameworks";
import {
  GITHUB_URL,
  NPM_URL,
  PACKAGE_VERSION,
  SITE_DESCRIPTION,
  SITE_TITLE,
} from "../site.config";

const features = [
  {
    title: "Works everywhere",
    body: "Native React plus Web Components and vanilla createDateTimePicker. Vue, Svelte, Angular, plain HTML, and CDN from one package.",
  },
  {
    title: "Pick and go",
    body: "Date-only overlays commit on day click. Datetime and time keep OK so you can set the clock first. DateTimeInput adds a calendar icon, customInput, and noStyle.",
  },
  {
    title: "Accessible calendar",
    body: "Dialog semantics, focus trap, Escape to dismiss, and arrow-key navigation. Opens on the first or last selectable day when bounds apply.",
  },
  {
    title: "Typed values & themes",
    body: "Omit asString for Date and TimeValue. CSS-variable themes, 12-hour clocks, locales, and TypeScript across ESM/CJS.",
  },
];

const modes = [
  { id: "date", label: "Date" },
  { id: "time", label: "Time" },
  { id: "datetime", label: "Datetime" },
  { id: "range", label: "Range" },
  { id: "locale", label: "Locale" },
  { id: "dark", label: "Dark" },
] as const;

const installCmd = "npm install universal-datetime-picker";
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  includeFaq={false}
  includeSoftwareApplication={true}
>
  <div class="site is-ready">
    <div class="site-bg" aria-hidden="true"></div>

    <SiteNav />

    <main id="top">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow">
            v{PACKAGE_VERSION} · React · Vanilla · Vue · Svelte · Angular · and more
          </p>
          <h1 id="hero-heading" class="hero-brand">
            universal-datetime-picker
          </h1>
          <p class="hero-tagline">
            A date and time picker for any framework.
          </p>
          <p class="hero-lead">
            Date, time, datetime, and ranges in one package. Use it from React,
            Vue, Svelte, Angular, vanilla JS, or a CDN script.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/examples/">Open examples</a>
            <a class="btn btn-ghost" href="/docs/">Read docs</a>
          </div>
          <div class="install-line">
            <code class="install-line__cmd" data-install-cmd>{installCmd}</code>
            <button
              type="button"
              class="install-copy"
              data-copy-install
              aria-label="Copy install command"
              title="Copy"
            >
              <svg
                data-copy-icon="default"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg
                data-copy-icon="done"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <div class="hero-stage" id="live-demo">
          <div class="stage-glow" aria-hidden="true"></div>
          <div class="stage-panel stage-panel--live">
            <div class="mode-switch" role="group" aria-label="Picker mode">
              {
                modes.map((m) => (
                  <button
                    type="button"
                    data-home-mode={m.id}
                    class:list={{ "is-active": m.id === "datetime" }}
                    aria-pressed={m.id === "datetime" ? "true" : "false"}
                  >
                    {m.label}
                  </button>
                ))
              }
            </div>
            <div class="stage-mount" data-home-stage></div>
            <p class="stage-value">
              Selected: <span data-home-stage-out>null</span>
            </p>
            <pre class="stage-snippet"><code data-home-mode-snippet></code></pre>
          </div>
        </div>
      </section>

      <section class="get-running" id="install" aria-labelledby="install-heading">
        <h2 id="install-heading" class="section-heading">Get running</h2>
        <p class="section-lead">
          Install once, then import the entry for your stack. Tabs below show
          the shortest path for each.
        </p>
        <div class="install-tabs" data-home-tabs>
          <div class="install-tablist" role="tablist" aria-label="Framework">
            {
              HOME_SNIPPET_TABS.map((t) => (
                <button
                  type="button"
                  role="tab"
                  data-tab={t.id}
                  class:list={{ "is-active": t.id === "react" }}
                  aria-selected={t.id === "react" ? "true" : "false"}
                >
                  {t.label}
                </button>
              ))
            }
          </div>
          <div class="install-panel">
            <button type="button" class="install-panel-copy" data-home-copy>
              Copy
            </button>
            <pre><code data-home-snippet-code>{HOME_SNIPPETS.react}</code></pre>
          </div>
          <a class="install-demo-link" data-home-demo-link href="/react/">
            Open the React page →
          </a>
        </div>
      </section>

      <section class="features" id="features" aria-labelledby="features-heading">
        <h2 id="features-heading" class="section-heading">Built for real forms</h2>
        <div class="features-grid features-grid--lines">
          {
            features.map((feature) => (
              <article class="feature feature--line">
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="demo-cta" id="frameworks" aria-labelledby="frameworks-heading">
        <div class="demo-cta__inner">
          <div>
            <h2 id="frameworks-heading">Try it live</h2>
            <p>
              Tune options in the playground, or open a framework page for install
              notes and a focused demo.
            </p>
          </div>
          <a class="btn btn-primary" href="/examples/">Open playground</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>
        MIT-licensed ·{" "}
        <a href="/docs/">Docs</a> {" · "}
        <a href="/docs/faq/">FAQ</a> {" · "}
        <a href="/examples/">Examples</a> {" · "}
        <a href="/changelog/">Changelog</a> {" · "}
        <a href="/react/">React</a> {" · "}
        <a href={NPM_URL} target="_blank" rel="noreferrer">npm</a> {" · "}
        <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
      </p>
    </footer>
  </div>
</BaseLayout>

<script>
  import {
    initHomeCopyInstall,
    initHomeInstallTabs,
    initHomeModeStage,
  } from "../scripts/homeVanilla.ts";

  let cleanup = () => {};
  cleanup = initHomeModeStage();
  initHomeInstallTabs();
  initHomeCopyInstall();

  document.addEventListener("astro:before-preparation", () => cleanup());
</script>

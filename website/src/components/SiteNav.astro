---
import { FRAMEWORKS } from "../frameworks";
import { GITHUB_URL } from "../site.config";

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
---

<header class="topbar">
  <a class="brand" href="/">
    <img class="brand-mark" src="/favicon.svg" alt="" width="18" height="18" aria-hidden="true" />
    <span class="brand-name">universal-datetime-picker</span>
  </a>

  <div class="topbar-actions">
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label="Switch to dark mode"
      title="Switch to dark mode"
      aria-pressed="false"
    >
      <svg
        class="theme-toggle__icon theme-toggle__icon--light"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
        ></path>
      </svg>
      <svg
        class="theme-toggle__icon theme-toggle__icon--dark"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>
  </div>

  <nav class="topnav" id="site-nav" data-site-nav aria-label="Primary">
    <a href="/docs/">Docs</a>
    <a href="/examples/">Examples</a>
    <a href="/changelog/">Changelog</a>
    <details class="topnav-dropdown">
      <summary>Frameworks</summary>
      <div class="topnav-dropdown-panel">
        {
          FRAMEWORKS.map((fw) => (
            <a
              href={`/${fw.slug}/`}
              class:list={{ "is-current": currentSlug === fw.slug }}
              aria-current={currentSlug === fw.slug ? "page" : undefined}
            >
              {fw.label}
            </a>
          ))
        }
      </div>
    </details>
    <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
  </nav>
</header>

{
  currentSlug ? (
    <nav class="framework-strip" aria-label="Framework pages">
      {FRAMEWORKS.map((fw) => (
        <a
          href={`/${fw.slug}/`}
          class:list={{ "is-active": fw.slug === currentSlug }}
          aria-current={fw.slug === currentSlug ? "page" : undefined}
        >
          {fw.label}
        </a>
      ))}
    </nav>
  ) : null
}

<script>
  import {
    initFrameworkDropdown,
    initMobileNav,
    initSiteTheme,
  } from "../scripts/theme.ts";

  initSiteTheme();
  initMobileNav();
  initFrameworkDropdown();
</script>

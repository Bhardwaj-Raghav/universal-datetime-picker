---
interface Props {
  demoHref?: string;
}

const { demoHref = "#live-demo" } = Astro.props;
const installCmd = "npm install universal-datetime-picker";
---

<div class="hero-actions">
  <a class="btn btn-ghost" href={demoHref}>Try the live demo</a>
</div>
<div class="install-line">
  <code class="install-line__cmd" data-install-cmd>{installCmd}</code>
  <button
    type="button"
    class="install-copy"
    data-copy-install
    aria-label="Copy install command"
    title="Copy"
  >
    <svg
      data-copy-icon="default"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <svg
      data-copy-icon="done"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </button>
</div>

<script>
  import { initHomeCopyInstall } from "../scripts/homeVanilla.ts";

  initHomeCopyInstall();
</script>

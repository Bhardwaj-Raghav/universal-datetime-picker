---
import BaseLayout from "./BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import CopyInstall from "../components/CopyInstall.astro";
import type { FrameworkDef } from "../frameworks";
import {
  frameworkDocsHref,
  GITHUB_URL,
  NPM_URL,
} from "../site.config";

interface Props {
  framework: FrameworkDef;
}

const { framework } = Astro.props;
const docsPrimary = frameworkDocsHref(framework.slug);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: `${framework.label}`, href: `/${framework.slug}/` },
];
---

<BaseLayout
  title={framework.pageTitle}
  description={framework.pageDescription}
  keywords={framework.pageKeywords}
  breadcrumbs={breadcrumbs}
>
  <div class="site is-ready">
    <div class="site-bg" aria-hidden="true"></div>

    <SiteNav currentSlug={framework.slug} />

    <main class="framework-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">{framework.label}</li>
        </ol>
      </nav>

      <header class="framework-header">
        <p class="eyebrow">{framework.install}</p>
        <h1>{framework.label} date time picker</h1>
        <p class="framework-intro">{framework.intro}</p>
        <p class="framework-tagline">{framework.tagline}</p>
        <CopyInstall demoHref="#framework-demo-heading" />
      </header>

      <section class="framework-demo" aria-labelledby="framework-demo-heading">
        <h2 id="framework-demo-heading">Live demo</h2>
        <slot name="demo" />
      </section>

      {
        framework.snippets.map((snippet) => (
          <section class="snippet framework-snippet">
            <h2>{snippet.title}</h2>
            <pre><code>{snippet.code}</code></pre>
          </section>
        ))
      }

      {
        framework.notes.length > 0 ? (
          <section class="framework-notes">
            <h2>Notes</h2>
            <ul>
              {framework.notes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </section>
        ) : null
      }

      <section class="framework-docs-links" aria-labelledby="framework-docs-heading">
        <h2 id="framework-docs-heading">Documentation</h2>
        <p class="framework-docs-lead">
          Guides for this stack and the shared API.
        </p>
        <ul class="framework-docs-list">
          <li><a href={docsPrimary}>Setup for {framework.label}</a></li>
          <li><a href="/docs/getting-started/">Getting started</a></li>
          <li><a href="/docs/props/">Props reference</a></li>
          <li><a href="/docs/theming/">Theming</a></li>
          <li><a href="/examples/">Examples playground</a></li>
        </ul>
      </section>
    </main>

    <footer class="footer">
      <p>
        MIT-licensed ·{" "}
        <a href="/examples/">Examples</a> {" · "}
        <a href="/docs/">Docs</a> {" · "}
        <a href={NPM_URL} target="_blank" rel="noreferrer">
          npm
        </a>{" "}
        ·{" "}
        <a href={GITHUB_URL} target="_blank" rel="noreferrer">
          GitHub
        </a>
      </p>
    </footer>
  </div>
</BaseLayout>

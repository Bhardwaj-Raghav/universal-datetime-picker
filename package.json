{
  "name": "react-calendar-time",
  "version": "1.1.2",
  "description": "React date picker, time picker, datetime picker, and date range calendar — accessible, TypeScript, dayjs, CSS themes",
  "license": "MIT",
  "author": "Raghav Bhardwaj",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bhardwaj-Raghav/react-calendar-time.git"
  },
  "homepage": "https://react-calendar-time.vercel.app",
  "bugs": {
    "url": "https://github.com/Bhardwaj-Raghav/react-calendar-time/issues"
  },
  "keywords": [
    "react",
    "reactjs",
    "react-component",
    "component",
    "ui",
    "ui-component",
    "form",
    "input",
    "picker",
    "date",
    "time",
    "datetime",
    "calendar",
    "datepicker",
    "date-picker",
    "timepicker",
    "time-picker",
    "datetimepicker",
    "datetime-picker",
    "date-time-picker",
    "date-time",
    "react-datepicker",
    "react-datetime",
    "react-datetime-picker",
    "react-date-picker",
    "react-time-picker",
    "react-calendar",
    "calendar-picker",
    "month-picker",
    "year-picker",
    "range",
    "date-range",
    "daterange",
    "date-range-picker",
    "daterangepicker",
    "range-picker",
    "calendar-range",
    "typescript",
    "ts",
    "types",
    "accessible",
    "accessibility",
    "a11y",
    "aria",
    "keyboard",
    "dayjs",
    "popup",
    "popover",
    "overlay",
    "inline",
    "modal",
    "dropdown",
    "select",
    "theme",
    "themeable",
    "theming",
    "css-variables",
    "dark-mode",
    "dark-theme",
    "light-theme",
    "i18n",
    "intl",
    "locale",
    "localization",
    "l10n",
    "12-hour",
    "24-hour",
    "ampm",
    "schedule",
    "booking",
    "appointment",
    "frontend",
    "web",
    "npm",
    "open-source",
    "mit",
    "react-calendar-time"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "sass src/styles/datepicker.scss dist/style.css --style=compressed --no-source-map",
    "dev": "vite --config playground/vite.config.ts",
    "website": "astro dev --root website --port 5174",
    "website:build": "astro build --root website",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^9.21.0",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/react": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/mime-types": "^3.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "astro": "^7.1.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "10.5.2",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "mime-types": "^3.0.2",
    "prettier": "^3.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.85.0",
    "sharp": "^0.35.3",
    "storybook": "^10.5.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}

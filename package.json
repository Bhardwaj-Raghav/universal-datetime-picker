{
  "name": "universal-datetime-picker",
  "version": "2.0.1",
  "description": "Universal date, time, datetime, and range picker for React, Vue, Svelte, Angular, vanilla JS, and CDN — accessible, TypeScript, dayjs, CSS themes",
  "license": "MIT",
  "author": "Raghav Bhardwaj",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bhardwaj-Raghav/universal-datetime-picker.git"
  },
  "homepage": "https://universal-datetime-picker.vercel.app",
  "bugs": {
    "url": "https://github.com/Bhardwaj-Raghav/universal-datetime-picker/issues"
  },
  "keywords": [
    "universal",
    "framework-agnostic",
    "headless",
    "react",
    "vue",
    "svelte",
    "angular",
    "vanilla",
    "web-components",
    "custom-elements",
    "cdn",
    "reactjs",
    "react-component",
    "component",
    "ui",
    "ui-component",
    "form",
    "input",
    "picker",
    "date",
    "time",
    "datetime",
    "calendar",
    "datepicker",
    "date-picker",
    "timepicker",
    "time-picker",
    "datetimepicker",
    "datetime-picker",
    "date-time-picker",
    "date-time",
    "react-datepicker",
    "react-datetime",
    "react-datetime-picker",
    "react-date-picker",
    "react-time-picker",
    "react-calendar",
    "calendar-picker",
    "month-picker",
    "year-picker",
    "range",
    "date-range",
    "daterange",
    "date-range-picker",
    "daterangepicker",
    "range-picker",
    "calendar-range",
    "typescript",
    "ts",
    "types",
    "accessible",
    "accessibility",
    "a11y",
    "aria",
    "keyboard",
    "dayjs",
    "popup",
    "popover",
    "overlay",
    "inline",
    "modal",
    "dropdown",
    "select",
    "theme",
    "themeable",
    "theming",
    "css-variables",
    "dark-mode",
    "dark-theme",
    "light-theme",
    "i18n",
    "intl",
    "locale",
    "localization",
    "l10n",
    "12-hour",
    "24-hour",
    "ampm",
    "schedule",
    "booking",
    "appointment",
    "frontend",
    "web",
    "npm",
    "open-source",
    "mit",
    "universal-datetime-picker"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/cdn/*",
    "./dist/wc/*",
    "./dist/vue/*",
    "./dist/svelte/*",
    "./dist/angular/*"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cdn/universal-datetime-picker.iife.js",
  "jsdelivr": "./dist/cdn/universal-datetime-picker.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.mjs",
      "require": "./dist/vanilla/index.js"
    },
    "./wc": {
      "types": "./dist/wc/index.d.ts",
      "import": "./dist/wc/index.mjs",
      "require": "./dist/wc/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.mjs",
      "require": "./dist/svelte/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.mjs",
      "require": "./dist/angular/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "sass src/styles/datepicker.scss dist/style.css --style=compressed --no-source-map",
    "dev": "vite --config playground/vite.config.ts",
    "website": "astro dev --root website --port 5174",
    "website:build": "astro build --root website",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@astrojs/preact": "^6.0.1",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/solid-js": "^7.0.1",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vue": "^7.0.1",
    "@eslint/js": "^9.21.0",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/react": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/mime-types": "^3.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "astro": "^7.1.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "10.5.2",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "mime-types": "^3.0.2",
    "preact": "^10.29.7",
    "prettier": "^3.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.85.0",
    "sharp": "^0.35.3",
    "solid-js": "^1.9.14",
    "storybook": "^10.5.2",
    "svelte": "^5.56.8",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue": "^3.5.40"
  },
  "engines": {
    "node": ">=18"
  }
}
